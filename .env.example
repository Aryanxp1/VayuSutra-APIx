# ==============================================================================
# VayuSutra APIx - Production Environment Configuration
# Ministry of Statistics and Programme Implementation (MoSPI) / RBI / DGCA
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_NAME=VayuSutra-APIx
APP_VERSION=2.0.0

# Server Bind Settings
HOST=0.0.0.0
PORT=8000
WORKERS_COUNT=4
TIMEOUT_KEEP_ALIVE=65

# Security & Authentication
# REQUIRED for production: replace with a strong random secret, e.g. run:
#     python3 -c "import secrets; print(secrets.token_hex(32))"
# Startup FAILS if AUTH_SECRET_KEY is missing while ENVIRONMENT=production is set
# (see vayusutra_apix/auth/security.py). Never commit a real secret.
AUTH_SECRET_KEY=CHANGE_ME__REPLACE_WITH_64_CHAR_HEX_SECRET
TOKEN_EXPIRY_SECONDS=604800
# CORS allowed origins (comma-separated). Use your real domain in production, e.g.:
#   CORS_ORIGINS=https://vayusutra.onrender.com
# "*" is the permissive default (fine for local development).
CORS_ORIGINS=*
ALLOWED_HOSTS=*

# Database Storage (SQLite WAL Mode)
# Container deployments persist app data under /app/vayusutra_apix/data — mount a
# volume (Docker) or a persistent disk (Render) at that path. This value matches
# the default used by vayusutra_apix/config/db.py inside the container.
DATABASE_PATH=/app/vayusutra_apix/data/vayusutra_airfare.db
SQLITE_CACHE_SIZE_KB=-64000
SQLITE_BUSY_TIMEOUT_MS=10000

# Built React frontend directory (served as the SPA by the FastAPI container)
FRONTEND_DIST_DIR=/app/frontend/dist

# Autonomous Ingestion Worker Daemon
INGESTION_WORKER_ENABLED=true
INGESTION_INTERVAL_SECONDS=60
SCRAPER_RATE_LIMIT_RPS=1.5
SCRAPER_JITTER_MIN_MS=50
SCRAPER_JITTER_MAX_MS=180

# External Government Connectors
MOSPI_ESANKHYIKI_URL=https://esankhyiki.mospi.gov.in
DGCA_STATISTICS_URL=https://dgca.gov.in

# Monitoring & OpenMetrics
PROMETHEUS_METRICS_ENABLED=true
ENABLE_LIVE_WEBSOCKET=true
